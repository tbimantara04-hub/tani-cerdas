# ══════════════════════════════════════════════════════
# Tani Cerdas Backend — Environment Variables Template
# ══════════════════════════════════════════════════════
# PETUNJUK:
#   1. Salin file ini → `cp .env.example .env`
#   2. Isi nilai setiap variabel (JANGAN commit file .env ke Git!)
#   3. Generate ENCRYPTION_KEY baru: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ══════════════════════════════════════════════════════

# LLM Mode: "local" (Ollama) atau "api" (GitHub Models)
# Untuk mode "api", buat Personal Access Token di: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here

# ⚠️  KRITIS: Generate key baru sebelum production!
# Perintah: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Jalankan hanya REST API tanpa inference langsung (true/false)
API_ONLY=true

# OpenWeatherMap API Key — daftar gratis di: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# CORS — pisahkan origin yang diizinkan dengan koma
# Contoh production: ALLOWED_ORIGINS=https://tani-cerdas.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# BAPANAS Panel Harga (opsional — contact pusdatin@badanpangan.go.id untuk akses)
BAPANAS_API_KEY=your_bapanas_api_key_here
